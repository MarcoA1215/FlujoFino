                                      EXTRA: {ex.quantity > 1 ? `${ex.quantity}x ` : ''}{ex.name} {!isKitchen && `(+${(Number(ex.priceUSD) * Number(ex.quantity || 1)).toFixed(2)})`}
                                    </div>
                                  ))}
                                </div>
