                                    </div>
                                  </div>
                                  <button
                                    type="button"
                                    onClick={() => copyToClipboard((Math.round((parseFloat(bookingPaymentAmount) || 0) * rateBs * 100) / 100).toFixed(2), 'Monto en Bs.')}
