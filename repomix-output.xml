  @Column('decimal', { nullable: true , precision: 12, scale: 4, transformer: new ColumnNumericTransformer()})
  exchangeRate: number;

  @Column('decimal', { nullable: true, precision: 12, scale: 4, transformer: new ColumnNumericTransformer() })
  usdReceived: number;

  @Column('decimal', { nullable: true, precision: 12, scale: 4, transformer: new ColumnNumericTransformer() })
  changeAmount: number;

  @Column('decimal', { nullable: true, precision: 12, scale: 4, transformer: new ColumnNumericTransformer() })
