                            <div style={{ fontSize: '13px', fontWeight: '800', color: '#92400E' }}>
                              {prod.name}
                            </div>
                            <div style={{ background: '#F59E0B', color: '#ffffff', padding: '4px 8px', borderRadius: '6px', fontSize: '11px', fontWeight: '700' }}>
