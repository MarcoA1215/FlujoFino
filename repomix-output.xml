                          <div style={{ fontWeight: '800', color: '#10B981' }}>
                            {formatLocalAmount(Number(selectedOrderForDetails.exchangeRate || exchangeRate))}
                          </div>
                        </div>
                      </div>

                      {/* Si pagó con USD (Monto Recibido y Vuelto) */}
