                            </div>
                          ) : (
                            <div style={{ fontSize: '11px', color: '#15803D', fontStyle: 'italic', marginTop: '4px' }}>
                              ✓ Cobro exacto sin vuelto
                            </div>
                          )}
                        </div>
                      )}

                      {/* Si fue Pago Móvil */}
