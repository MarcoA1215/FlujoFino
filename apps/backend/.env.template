# =========================================================================
# FinoWork - Backend Environment Configuration (.env)
# =========================================================================

# -------------------------------------------------------------------------
# 1. Entorno y Red
# -------------------------------------------------------------------------
NODE_ENV=production
PORT=3001

# URL oficial de la aplicación Web en Vercel
FRONTEND_URL=https://finowork.vercel.app

# URL alterna para la versión móvil / APK (si aplica)
FRONTEND_URL_APK=https://finowork-apk.vercel.app

# -------------------------------------------------------------------------
# 2. Base de Datos (PostgreSQL en Render, Supabase, Neon o Railway)
# -------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/finowork?sslmode=require"
# OBLIGATORIO EN PRODUCCIÓN: Mantener en false para no alterar/borrar tablas
DB_SYNCHRONIZE=false

# -------------------------------------------------------------------------
# 3. Seguridad y Cuentas Maestras
# -------------------------------------------------------------------------
# Generar una clave secreta segura de mínimo 32 caracteres
JWT_SECRET="genera-un-secreto-aleatorio-seguro-de-32-caracteres"

# Correo y contraseña del Super Administrador de la plataforma (/platform-admin)
SUPERADMIN_EMAIL="admin@finowork.com"
SUPERADMIN_PASSWORD="clave-secreta-fuerte-superadmin"

# -------------------------------------------------------------------------
# 4. Tasas de Cambio y Cotizaciones (BCV / Paralelo / USDT)
# -------------------------------------------------------------------------
COTIZAVE_API_KEY="tu-api-key-de-cotizave-o-monitoreo"

# -------------------------------------------------------------------------
# 5. Almacenamiento en la Nube (Cloudflare R2 / AWS S3)
#    Para imágenes de productos, logotipos y comprobantes de pago
# -------------------------------------------------------------------------
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="finowork-uploads"
S3_ACCESS_KEY_ID="tu-access-key-id"
S3_SECRET_ACCESS_KEY="tu-secret-access-key"
S3_REGION="auto"
# Dominio público o URL de CDN para servir archivos cargados
S3_PUBLIC_URL="https://pub-<id>.r2.dev"

# -------------------------------------------------------------------------
# 6. Web Push Notifications (Notificaciones Push en Navegador y App)
# -------------------------------------------------------------------------
VAPID_PUBLIC_KEY="BOVNV5aBYlzYON15tj1DdHNuR-YNYsotD3BRGgoCjIOEchUZ2C8rRd7nhDOP-Qis-x5rPKcmpdXOJ9N2hPNGsAI"
VAPID_PRIVATE_KEY="lj7fJ1UKpWb3uy0U03xQigJCxPAI4QU5gEOoTUH2mJg"
VAPID_SUBJECT="mailto:admin@finowork.com"

# -------------------------------------------------------------------------
# 7. Correo Electrónico SMTP (Verificación de Cuentas y Restablecer Clave)
# -------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=notificaciones@finowork.com
MAIL_PASS=tu-clave-de-aplicacion-o-smtp-token
MAIL_FROM="FinoWork" <notificaciones@finowork.com>

# -------------------------------------------------------------------------
