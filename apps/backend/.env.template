# =========================================================================
# FinoWork - Backend Environment Configuration (.env)
# =========================================================================

# Entorno y Servidor
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://finowork.vercel.app

# Base de Datos (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/finowork?sslmode=require"
DB_SYNCHRONIZE=false

# Seguridad JWT (Generar una clave de al menos 32 caracteres aleatorios)
JWT_SECRET="clave-secreta-super-segura-de-produccion"

# Integraciones de Tasas (BCV / Paralelo)
COTIZAVE_API_KEY="api-key"

# Almacenamiento en la Nube (Cloudflare R2 / AWS S3) para Imágenes y Comprobantes
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="finowork-uploads"
S3_ACCESS_KEY_ID="tu-access-key-id"
S3_SECRET_ACCESS_KEY="tu-secret-access-key"
S3_REGION="auto"

# Monitoreo de Errores y Rendimiento (Sentry) - Opcional en desarrollo
SENTRY_DSN=""

# Correo SMTP (Gmail / Amazon SES) para Verificación de Cuentas y Notificaciones
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=notificaciones@finowork.com
MAIL_PASS=tu-clave-aplicacion
MAIL_FROM="FinoWork" <notificaciones@finowork.com>

# Canal oficial de Soporte por WhatsApp (58414XXXXXXX)
SUPPORT_WHATSAPP_NUMBER=584145652381